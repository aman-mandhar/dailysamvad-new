APP_NAME="Daily Samvad"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production recommendation: LOG_STACK=daily and LOG_LEVEL=warning
# LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Set SESSION_SECURE_COOKIE=true when production is served exclusively over HTTPS.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_LIBRARY_PATH=media/library
MEDIA_MAX_UPLOAD_KILOBYTES=10240
QUEUE_CONNECTION=database

ANALYTICS_ENABLED=true
ANALYTICS_BEACON_ENABLED=true
# Run a supervised queue worker only when queued features are enabled.
QUEUE_ARCHITECTURE_ENABLED=false
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_DB=3
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=
# Phase 2.1-G staged cache rollout (disabled by default)
CACHE_ARCHITECTURE_ENABLED=false
CACHE_ARCHITECTURE_STORE=redis
CACHE_FULL_PAGE_ENABLED=false
CACHE_QUERY_ENABLED=false
CACHE_DASHBOARD_ENABLED=false
CACHE_FRAGMENT_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Set uniquely per deployment/environment, e.g. dailysamvad:local:
# REDIS_PREFIX=dailysamvad:local:
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default

